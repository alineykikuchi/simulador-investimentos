<?xml version="1.0" encoding="utf-8"?>
<RunSettings>

  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <!-- Critério de aceite: cobertura acima de 90% na camada lógica.
               A API (composição/transporte) fica fora da medição. -->
          <Include>[SimuladorInvestimentos.Domain]*,[SimuladorInvestimentos.Application]*</Include>
          <ExcludeByAttribute>GeneratedCodeAttribute,CompilerGeneratedAttribute,ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>
          <SkipAutoProps>true</SkipAutoProps>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>

</RunSettings>
